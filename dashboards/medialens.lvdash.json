{
  "datasets": [
    {
      "name": "historico",
      "displayName": "Histórico mensal por filme",
      "queryLines": [
        "SELECT concat(r.title, ' · ', cast(r.movie_id AS STRING)) AS filme,\n",
        "       h.rating_month AS mes, h.rating_count AS avaliacoes,\n",
        "       h.cumulative_rating_count AS avaliacoes_acumuladas,\n",
        "       round(h.monthly_average_rating, 3) AS nota_mensal,\n",
        "       round(h.cumulative_average_rating, 3) AS nota_acumulada\n",
        "FROM workspace.medialens_gold.movielens_movie_rating_history h\n",
        "JOIN workspace.medialens_gold.movielens_movie_ratings r USING (dataset_version, source, movie_id, scale_min, scale_max)\n",
        "WHERE h.dataset_version = 'ml-latest-2023-07-20' AND h.source = 'movielens'"
      ]
    },
    {
      "name": "generos",
      "displayName": "Notas e volume por gênero",
      "queryLines": [
        "SELECT genero, count(*) AS filmes, sum(rating_count) AS avaliacoes,\n",
        "       round(try_divide(sum(rating_sum), sum(rating_count)), 3) AS nota_media\n",
        "FROM workspace.medialens_gold.movielens_movie_ratings\n",
        "LATERAL VIEW explode(genres) g AS genero\n",
        "WHERE dataset_version = 'ml-latest-2023-07-20' AND source = 'movielens'\n",
        "GROUP BY genero"
      ]
    },
    {
      "name": "ranking",
      "displayName": "Filmes mais bem avaliados",
      "queryLines": [
        "SELECT title AS filme, movie_id, round(average_rating, 3) AS nota_media,\n",
        "       rating_count AS avaliacoes, CAST(first_rated_at AS DATE) AS primeira_avaliacao,\n",
        "       CAST(last_rated_at AS DATE) AS ultima_avaliacao\n",
        "FROM workspace.medialens_gold.movielens_movie_ratings\n",
        "WHERE dataset_version = 'ml-latest-2023-07-20' AND source = 'movielens' AND rating_count >= 100\n",
        "ORDER BY average_rating DESC, rating_count DESC, movie_id\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "auditoria",
      "displayName": "Reconciliação por camada",
      "queryLines": [
        "SELECT bronze_rows AS bronze, silver_events AS silver,\n",
        "       gold_events AS gold_por_filme, history_events AS gold_por_mes,\n",
        "       rejected_rows AS rejeitadas, exact_duplicate_rows AS copias, gold_films AS filmes\n",
        "FROM workspace.medialens_gold.movielens_quality\n",
        "WHERE dataset_version = 'ml-latest-2023-07-20'"
      ]
    },
    {
      "name": "rejeicoes",
      "displayName": "Linhas rejeitadas por regra",
      "queryLines": [
        "SELECT rejection_reason AS regra, sum(source_row_count) AS linhas\n",
        "FROM workspace.medialens_silver.movielens_rating_rejects\n",
        "WHERE dataset_version = 'ml-latest-2023-07-20' AND source = 'movielens'\n",
        "GROUP BY rejection_reason"
      ]
    }
  ],
